{
  "family": "photos-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::266735814394:role/photos-service-task-execution-role",
  "taskRoleArn": "arn:aws:iam::266735814394:role/photos-service-task-role",
  "containerDefinitions": [
    {
      "name": "photos",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "eu-central-1"
        },
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "eu-central-1"
        },
        {
          "name": "STATIC_BUCKET_NAME",
          "value": "photo-gallery-dir-266735814394-eu-central-1"
        },
        {
          "name": "CLOUDFRONT_DOMAIN",
          "value": "dkuafucu8y959.cloudfront.net"
        },
        {
          "name": "DB_HOST",
          "value": "photo-gallery-containersstack-v4yrxows-rdsinstance-ylyjrl5aeikw.cxii6mikg9c3.eu-central-1.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_NAME",
          "value": "photogallery"
        },
        {
          "name": "DB_SECRET_ARN",
          "value": "arn:aws:secretsmanager:eu-central-1:266735814394:secret:rds!db-70d8bb6e-c35a-459f-bb3a-54fbea4603cc-mg5VSW"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/photo_gallery",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "photos"
        }
      }
    }
  ]
}
